# 앱용 예시. 저장소 루트의 .env로 복사한 뒤 실제 값을 채우세요(Git 제외).
# Supabase 프로젝트의 Connect 또는 Settings > API Keys에서 확인합니다.
# 값은 채팅에 보내지 말고, 작성 후 '앱 env 작성 완료'라고 알려주세요.
# EXPO_PUBLIC_ 값은 앱에 포함됩니다. secret/service_role/DB 비밀번호 금지.
# 현재는 연결 준비용이며 Supabase 클라이언트 구현은 아직 없습니다.

# 이 앱에 연결할 개발 프로젝트 URL
EXPO_PUBLIC_SUPABASE_URL=

# 같은 프로젝트의 publishable key (sb_publishable_로 시작)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
