{
  "expo": {
    "name": "chroma-note",
    "slug": "chroma-note",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chromanote",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "M382EW7FD8",
      "icon": "./assets/expo.icon",
      "deploymentTarget": "17.0",
      "bundleIdentifier": "com.cheng80.chromanote"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EA",
          "image": "./assets/images/splash-chroma-note.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "완성한 Chroma Note 기록 이미지를 사진 보관함에 저장합니다.",
          "granularPermissions": []
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "./plugins/with-private-http-cache"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "16598ccb-6c01-4b84-a3ae-716990132a22"
      }
    },
    "owner": "cheng80"
  }
}
