          "lineHeight": 1.5,
          "fontFamily": "$font-body",
          "fontSize": 20,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "AZHpl",
          "name": "Primary flow",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Book → 사진 가져오기 → 처리 → ① 원본·Line art 비교 → ② 기록 요약 → 저장",
          "lineHeight": 1.5,
